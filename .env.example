# Copy to .env and fill in. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Hugging Face token — REQUIRED.
# Geppetto depends on one GATED repo, and can optionally use a second. Accept
# the licences with the same account that owns this token, then paste it here:
#   https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m  (manual approval, required)
#   https://huggingface.co/briaai/RMBG-2.0                           (auto approval, optional,
#                                       non-commercial; only for GEPPETTO_MATTING=rmbg2)
# Create a read token at https://huggingface.co/settings/tokens
#
# Approval is per-account: every operator requests their own. You cannot run
# Geppetto on someone else's grant.
# ---------------------------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------------------------
# GPU assignment. `nvidia-smi -L` lists the indices.
# Leave at 0 for a single-GPU machine. On a multi-GPU box where GPU 0 drives a
# display, point the service at another index (e.g. GPU_ID=1) to keep the
# desktop responsive during generation.
# GPU_ID_2 is only used by the opt-in `scale` compose profile, which runs a
# second worker on a second card.
# ---------------------------------------------------------------------------
GPU_ID=0
GPU_ID_2=1

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
API_PORT=8080
API_PORT_2=8081
UI_PORT=7860

# ---------------------------------------------------------------------------
# Attention backend. Valid values are exactly: flash_attn, flash_attn_3,
# xformers — UNDERSCORES, not hyphens. Upstream silently ignores anything it
# does not recognise, so a typo here does not error; it quietly keeps the
# image default.
#
# Sparse attention accepts only these three (there is no sdpa fallback as
# there is for dense attention), so the value must be one the image ships.
# The nvidia-cuda image ships flash_attn; the dgx-spark image ships xformers.
# ---------------------------------------------------------------------------
ATTN_BACKEND=flash_attn

# ---------------------------------------------------------------------------
# Which image compose runs. Set this to use a published container instead of
# building locally, e.g.
#   GEPPETTO_IMAGE=ghcr.io/floatingsidewal/geppetto:nvidia-cuda-latest
# ---------------------------------------------------------------------------
# GEPPETTO_IMAGE=

# ---------------------------------------------------------------------------
# Browser origins allowed to call the API. The default is permissive so the
# single-page UI works when opened straight off disk (a file:// page sends
# Origin: null).
#
# This service has NO AUTHENTICATION — anything that can reach the port can
# drive the GPU. CORS is not what protects it. On anything but a trusted
# network, put a reverse proxy with auth in front and restrict this to the
# origins you actually serve the UI from.
# ---------------------------------------------------------------------------
GEPPETTO_CORS_ORIGINS=*

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Offline mode. Leave at 0 for first setup so fetch-models.sh and the first
# start can download. Once the trellis2-models volume is populated, set to 1
# and the container never contacts Hugging Face: startup skips the revision
# check and no longer depends on HF_TOKEN or on your gated grants.
# ---------------------------------------------------------------------------
HF_HUB_OFFLINE=0

# ---------------------------------------------------------------------------
# Licence switches. See HOWTO.md "Licence switches" and docs/LICENSES-MODELS.md.
# The defaults run no non-commercial code. Each request can override them
# with "export_backend" / "matting".
#
# GEPPETTO_EXPORT_BACKEND  open        texture bake in plain PyTorch (default)
#                          nvdiffrast  upstream's bake: NVIDIA Source Code
#                                      License, non-commercial
# GEPPETTO_MATTING         birefnet    ZhengPeng7/BiRefNet, MIT (default)
#                          rmbg2       briaai/RMBG-2.0, CC BY-NC 4.0; fetch it
#                                      with fetch-models.sh --with-rmbg2
# Neither matting model loads until an opaque image needs its background removed.
# ---------------------------------------------------------------------------
GEPPETTO_EXPORT_BACKEND=open
GEPPETTO_MATTING=birefnet
