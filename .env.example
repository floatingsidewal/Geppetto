# Copy to .env and fill in. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Hugging Face token — REQUIRED.
# TRELLIS.2 depends on two GATED repos. Accept both licences with the same
# account that owns this token, then paste the token here:
#   https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m  (manual approval)
#   https://huggingface.co/briaai/RMBG-2.0                           (auto approval)
# Create a read token at https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------------------------
# GPU assignment. GPU 0 drives the display on this workstation, so the service
# defaults to GPU 1. `nvidia-smi -L` lists the indices.
# ---------------------------------------------------------------------------
GPU_ID=1
GPU_ID_2=0

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
API_PORT=8080
API_PORT_2=8081
UI_PORT=7860

# ---------------------------------------------------------------------------
# Attention backend: flash-attn (default) or xformers if flash-attn misbehaves.
# ---------------------------------------------------------------------------
ATTN_BACKEND=flash-attn

LOG_LEVEL=INFO
